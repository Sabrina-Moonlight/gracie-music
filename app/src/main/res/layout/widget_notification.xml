<?xml version="1.0" encoding="utf-8"?>
<!-- Widget estilo notificación (4x2). Posiciones medidas sobre la notificación real:
     título, artista, barra con olas, tiempos,
     5 botones agrupados al centro (cada uno ocupa 1/8 del ancho). -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingTop="18dp"
    android:paddingBottom="18dp"
    android:theme="@style/Theme.Widget.vivimusic">

  <!-- Margen arriba y abajo: así queda igual de alto que el widget de reloj de Samsung -->
  <FrameLayout
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background">

    <ImageView
        android:id="@+id/widget_n_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:importantForAccessibility="no" />

    <LinearLayout
        android:id="@+id/widget_n_open_area"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingTop="22dp">

        <TextView
            android:id="@+id/widget_n_song_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="28dp"
            android:layout_marginEnd="28dp"
            android:includeFontPadding="false"
            android:text="@string/not_playing"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#FFFFFFFF"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/widget_n_artist_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="28dp"
            android:layout_marginEnd="28dp"
            android:includeFontPadding="false"
            android:text="@string/tap_to_play"
            android:textSize="14sp"
            android:textColor="#B3FFFFFF"
            android:maxLines="1"
            android:ellipsize="end" />

        <!-- Separador: en widgets no se permite <View>, por eso es un FrameLayout vacío -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- Barra de progreso: fitCenter mantiene el círculo redondo -->
        <ImageView
            android:id="@+id/widget_n_progress"
            android:layout_width="match_parent"
            android:layout_height="28dp"
            android:layout_marginStart="28dp"
            android:layout_marginEnd="28dp"
            android:scaleType="fitCenter"
            android:importantForAccessibility="no" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="28dp"
            android:layout_marginEnd="28dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/widget_n_time_current"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:includeFontPadding="false"
                android:text="00:00"
                android:textSize="11sp"
                android:textColor="#B3FFFFFF" />

            <TextView
                android:id="@+id/widget_n_time_total"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:text="00:00"
                android:textSize="11sp"
                android:textColor="#B3FFFFFF" />
        </LinearLayout>

        <!-- Botones agrupados al centro: 3 + (5 x 2) + 3 partes, o sea cada botón ocupa 1/8 del ancho -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="3" />
            <ImageButton
                android:id="@+id/widget_n_like"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="2"
                android:padding="6dp"
                android:scaleType="fitCenter"
                android:background="@android:color/transparent"
                android:src="@drawable/ic_widget_n_heart_off"
                android:contentDescription="@string/like" />
            <ImageButton
                android:id="@+id/widget_n_prev"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="2"
                android:padding="6dp"
                android:scaleType="fitCenter"
                android:background="@android:color/transparent"
                android:src="@drawable/ic_widget_n_prev"
                android:contentDescription="@string/previous" />
            <FrameLayout
                android:id="@+id/widget_n_play_container"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="2">

                <ImageView
                    android:id="@+id/widget_n_play_pause"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_widget_n_play"
                    android:contentDescription="@string/play_pause" />
            </FrameLayout>
            <ImageButton
                android:id="@+id/widget_n_next"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="2"
                android:padding="6dp"
                android:scaleType="fitCenter"
                android:background="@android:color/transparent"
                android:src="@drawable/ic_widget_n_next"
                android:contentDescription="@string/next" />
            <ImageButton
                android:id="@+id/widget_n_repeat"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="2"
                android:padding="6dp"
                android:scaleType="fitCenter"
                android:background="@android:color/transparent"
                android:src="@drawable/ic_widget_n_repeat_off"
                android:contentDescription="@string/repeat" />
            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="3" />
        </LinearLayout>

    </LinearLayout>
  </FrameLayout>
</FrameLayout>
