<?xml version="1.0" encoding="utf-8"?>
<!-- Widget estilo notificación de Android (4x2): portada de fondo, texto arriba, barra con onda en medio, botones abajo -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:theme="@style/Theme.Widget.vivimusic">

    <ImageView
        android:id="@+id/widget_n_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:importantForAccessibility="no" />

    <LinearLayout
        android:id="@+id/widget_n_open_area"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="10dp"
        android:paddingBottom="6dp">

        <TextView
            android:id="@+id/widget_n_song_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/not_playing"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#FFFFFFFF"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/widget_n_artist_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/tap_to_play"
            android:textSize="13sp"
            android:textColor="#B3FFFFFF"
            android:maxLines="1"
            android:ellipsize="end" />

        <!-- Separador: en widgets no se permite <View>, por eso es un FrameLayout vacío -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- Barra de progreso: fitCenter mantiene el círculo redondo -->
        <ImageView
            android:id="@+id/widget_n_progress"
            android:layout_width="match_parent"
            android:layout_height="28dp"
            android:scaleType="fitCenter"
            android:importantForAccessibility="no" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/widget_n_time_current"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="00:00"
                android:textSize="11sp"
                android:textColor="#B3FFFFFF" />

            <TextView
                android:id="@+id/widget_n_time_total"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="00:00"
                android:textSize="11sp"
                android:textColor="#B3FFFFFF" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageButton
                android:id="@+id/widget_n_like"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_weight="1"
                android:padding="8dp"
                android:scaleType="fitCenter"
                android:background="@android:color/transparent"
                android:src="@drawable/ic_widget_n_heart_off"
                android:contentDescription="@string/like" />
            <ImageButton
                android:id="@+id/widget_n_prev"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_weight="1"
                android:padding="8dp"
                android:scaleType="fitCenter"
                android:background="@android:color/transparent"
                android:src="@drawable/ic_widget_n_prev"
                android:contentDescription="@string/previous" />
            <FrameLayout
                android:id="@+id/widget_n_play_container"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_weight="1">

                <ImageView
                    android:id="@+id/widget_n_play_pause"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_widget_n_play"
                    android:contentDescription="@string/play_pause" />
            </FrameLayout>

            <ImageButton
                android:id="@+id/widget_n_next"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_weight="1"
                android:padding="8dp"
                android:scaleType="fitCenter"
                android:background="@android:color/transparent"
                android:src="@drawable/ic_widget_n_next"
                android:contentDescription="@string/next" />
            <ImageButton
                android:id="@+id/widget_n_repeat"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_weight="1"
                android:padding="8dp"
                android:scaleType="fitCenter"
                android:background="@android:color/transparent"
                android:src="@drawable/ic_widget_n_repeat_off"
                android:contentDescription="@string/repeat" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
