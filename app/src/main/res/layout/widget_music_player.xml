<?xml version="1.0" encoding="utf-8"?>
<!-- Widget estilo notificación: portada nítida de fondo + texto, barra y 5 controles encima -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:clipToOutline="true"
    android:theme="@style/Theme.Widget.vivimusic">

    <!-- Portada de fondo (se dibuja por código) -->
    <ImageView
        android:id="@+id/widget_background_art"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:src="@mipmap/ic_launcher"
        android:contentDescription="@string/album_art" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="top"
        android:orientation="vertical"
        android:paddingStart="18dp"
        android:paddingEnd="18dp"
        android:paddingTop="12dp"
        android:paddingBottom="4dp">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1.4" />

        <TextView
            android:id="@+id/widget_song_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/not_playing"
            android:textSize="17sp"
            android:fontFamily="sans-serif-medium"
            android:textColor="#FFFFFF"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/widget_artist_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/tap_to_play"
            android:textSize="14sp"
            android:textColor="#B3FFFFFF"
            android:maxLines="1"
            android:ellipsize="end"
            android:layout_marginTop="1dp" />

        <!-- Espacio flexible: empuja barra, tiempos y controles hacia abajo -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- Barra de progreso con onda y círculo (se dibuja por código) -->
        <ImageView
            android:id="@+id/widget_progress_track"
            android:layout_width="match_parent"
            android:layout_height="24dp"
            android:scaleType="fitXY"
            android:contentDescription="@null" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/widget_time_current"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="00:00"
                android:textSize="12sp"
                android:textColor="#B3FFFFFF" />

            <TextView
                android:id="@+id/widget_time_total"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="00:00"
                android:textSize="12sp"
                android:textColor="#B3FFFFFF" />
        </LinearLayout>

        <!-- Controles: me gusta | anterior | play | siguiente | repetir -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginTop="2dp">

            <ImageButton
                android:id="@+id/widget_like_button"
                android:layout_width="52dp"
                android:layout_height="44dp"
                android:padding="10dp"
                android:scaleType="fitCenter"
                android:background="@android:color/transparent"
                android:src="@drawable/ic_widget_n_heart_outline"
                android:contentDescription="@string/like"
                android:tint="#FFFFFF" />

            <ImageButton
                android:id="@+id/widget_prev_button"
                android:layout_width="52dp"
                android:layout_height="44dp"
                android:padding="8dp"
                android:scaleType="fitCenter"
                android:background="@android:color/transparent"
                android:src="@drawable/ic_widget_n_skip_previous"
                android:contentDescription="@string/previous"
                android:tint="#FFFFFF" />

            <FrameLayout
                android:id="@+id/widget_play_pause_container"
                android:layout_width="60dp"
                android:layout_height="44dp">

                <ImageView
                    android:id="@+id/widget_play_pause"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_widget_n_play"
                    android:tint="#FFFFFF"
                    android:contentDescription="@string/play_pause" />
            </FrameLayout>

            <ImageButton
                android:id="@+id/widget_next_button"
                android:layout_width="52dp"
                android:layout_height="44dp"
                android:padding="8dp"
                android:scaleType="fitCenter"
                android:background="@android:color/transparent"
                android:src="@drawable/ic_widget_n_skip_next"
                android:contentDescription="@string/next"
                android:tint="#FFFFFF" />

            <ImageButton
                android:id="@+id/widget_repeat_button"
                android:layout_width="52dp"
                android:layout_height="44dp"
                android:padding="10dp"
                android:scaleType="fitCenter"
                android:background="@android:color/transparent"
                android:src="@drawable/ic_widget_n_repeat"
                android:contentDescription="@string/repeat_mode_off"
                android:tint="#FFFFFF" />
        </LinearLayout>

    </LinearLayout>

</FrameLayout>
